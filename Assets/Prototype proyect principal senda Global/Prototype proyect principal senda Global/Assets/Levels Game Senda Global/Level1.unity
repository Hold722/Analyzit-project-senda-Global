  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ea869004d8de2b4aaa5464441e9fd5e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 1869068235}
  dialogueText: {fileID: 330820495}
  dialogues:
  - '!Cuidado al cruzar! el Mohan esta de un mal genio terrible y bloqueo el paso
    por el rio'
  - "Dicen que lo \xFAnico que lo calma es recordar las tradiciones de nuestra tierra.
    Necesitamos 6 Bele\xF1os tradicionales."
  - "B\xFAscalos por la orilla. Cuando los tengas todos, cruza este puente con confianza
    y entr\xE9gaselos."
